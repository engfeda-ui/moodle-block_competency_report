{{!
    Template for block_competency_report content.

    @package    block_competency_report
    @copyright  2026 Mahmoud Salem
    @license    http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later

    Context variables:
        - is_dashboard   {bool}   True when shown on the site dashboard (SITEID).
        - proficient     {int}    Number of proficient competencies (dashboard mode).
        - total          {int}    Total competencies for this user (dashboard mode).
        - percent        {int}    Percentage proficient 0-100 (dashboard mode).
        - summary_text   {string} Localised intro sentence.
        - report_url     {string} URL to the full student report (course mode).
        - viewreport_str {string} Localised button label.
}}
<div class="block-competency-report">
    <p class="text-muted small mb-2">{{summary_text}}</p>

    {{#is_dashboard}}
    <div class="d-flex justify-content-between align-items-center mb-1">
        <span class="font-weight-bold">{{proficient_label}}</span>
        <span class="badge badge-primary bg-primary text-white">{{proficient}} / {{total}}</span>
    </div>
    {{#has_data}}
    <div class="progress mb-2" style="height: 12px;" role="progressbar"
         aria-valuenow="{{percent}}" aria-valuemin="0" aria-valuemax="100"
         aria-label="{{proficient_label}}">
        <div class="progress-bar {{bar_class}}" style="width: {{percent}}%"></div>
    </div>
    <p class="text-right small text-muted mb-0">{{percent}}%</p>
    {{/has_data}}
    {{^has_data}}
    <p class="text-muted small">{{nodata_str}}</p>
    {{/has_data}}
    {{/is_dashboard}}

    {{^is_dashboard}}
    <a href="{{report_url}}" class="btn btn-primary btn-block w-100 mt-2">
        {{viewreport_str}}
    </a>
    {{/is_dashboard}}
</div>
